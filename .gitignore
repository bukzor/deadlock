# Generated output under data/ is ignored by default: bulk/binary assets, the
# vendored VRF tool, intermediate dirs (data/gamedata/, the dense views in
# gamedata.dense.tsv/), the near-verbatim Valve extracts (gamedata.json/,
# manifest.jsonl), the per-DLL documents (dlls/<facet>/, dlls.list), the
# check outputs (dlls.check/), and the engine's own cvarlist captures (cvarlist/).
# Exceptions — committed so `git diff` shows patch changes — are the
# transformative TSV views (gamedata.tsv/, dlls/<facet>.tsv), the build stamp
# naming the game version that produced them, the latest-VRF-release record,
# and the redo .do scripts (source).
# See docs/dev/decisions.kb/commit-diffable-data-let-git-diff.md
/data/*
!/data/*.do
!/data/deadlock-version.json
!/data/tools/
/data/tools/*
!/data/tools/*.do
!/data/tools/vrf-release.json
!/data/gamedata.json/
/data/gamedata.json/*
!/data/gamedata.json/*.do
!/data/gamedata.dense.tsv/
/data/gamedata.dense.tsv/*
!/data/gamedata.dense.tsv/*.do
!/data/gamedata.tsv/
/data/gamedata.tsv/*
!/data/gamedata.tsv/*.do
!/data/gamedata.tsv/*.tsv
!/data/dlls/
/data/dlls/*
!/data/dlls/*.do
!/data/dlls/*.tsv
!/data/dlls/*/
/data/dlls/*/*
!/data/dlls/*/*.do
!/data/dlls.check/
/data/dlls.check/*
!/data/dlls.check/*.do
!/data/cvarlist/
/data/cvarlist/*
!/data/cvarlist/*.do

# redo's markers for the phony aggregator targets (all.do, clean.do)
/all
/clean

# machine-local env, loaded last by .envrc (e.g. DEADLOCK_HOME on a WSL box)
/localhost.env

# python / tooling
/.redo/
/.venv/
__pycache__/
*.pyc
.pytest_cache/
.pyright/
trash/
