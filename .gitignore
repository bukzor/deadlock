# Generated output under data/ is ignored by default: bulk/binary assets, the
# vendored VRF tool, intermediate dirs (data/gamedata/), and the near-verbatim
# Valve extracts (gamedata.flat/, manifest.jsonl).
# Exceptions — committed so `git diff` shows patch changes — are the
# transformative TSV views, the build stamp naming the game version that
# produced them, and the redo .do scripts (source).
# See docs/dev/decisions.kb/commit-diffable-data-let-git-diff.md
/data/*
!/data/*.do
!/data/deadlock-version.json
!/data/tools/
/data/tools/*
!/data/tools/*.do
!/data/gamedata.flat/
/data/gamedata.flat/*
!/data/gamedata.flat/*.do
!/data/gamedata.tsv/
/data/gamedata.tsv/*
!/data/gamedata.tsv/*.do
!/data/gamedata.tsv/*.tsv

# redo's markers for the phony aggregator targets (all.do, clean.do)
/all
/clean

# machine-local env, loaded last by .envrc (e.g. DEADLOCK_HOME on a WSL box)
/localhost.env

# python / tooling
/.redo/
/.venv/
__pycache__/
*.pyc
.pytest_cache/
.pyright/
trash/
