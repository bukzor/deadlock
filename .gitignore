# Generated output under data/ is mostly ignored: bulk/binary assets, the
# vendored VRF tool, intermediate dirs (e.g. data/gamedata/), and the TSV views
# (derivable from committed data alone; `redo` them on demand).
# Exceptions — committed so `git diff` shows patch changes — are the artifacts
# that need the game install to regenerate (the manifest and the flattened
# leaves), plus the redo .do scripts (source).
/data/*
!/data/*.do
!/data/gamedata.flat/
!/data/gamedata.flat/**
!/data/gamedata.tsv/
/data/gamedata.tsv/*
!/data/gamedata.tsv/*.do
!/data/manifest.jsonl

# redo's markers for the phony aggregator targets (all.do, clean.do)
/all
/clean

# python / tooling
/trash/
/.redo/
/.venv/
__pycache__/
*.pyc
.pytest_cache/
.pyright/
trash/
