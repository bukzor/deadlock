# Generated output under data/ is mostly ignored: bulk/binary assets, the
# vendored VRF tool, and intermediate dirs (e.g. data/gamedata/).
# Exceptions are the line-grained, git-diffable JSONL artifacts and the redo
# .do scripts (source) — these ARE committed so `git diff` shows patch changes.
/data/*
!/data/*.do
!/data/manifest.jsonl
!/data/gamedata.jsonl

# python / tooling
/.redo/
/.venv/
__pycache__/
*.pyc
.pytest_cache/
.pyright/
