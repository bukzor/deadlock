{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sandbox readings of one experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "dummies"],
  "properties": {
    "experiment": {"type": "string", "minLength": 1},
    "dummies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["max_health", "spirit_resist", "regen", "scenarios"],
        "properties": {
          "max_health": {"type": "integer"},
          "spirit_resist": {"type": "number", "minimum": 0, "maximum": 1},
          "regen": {
            "description": "Health per second; the values that recurred across repeated measurements.",
            "type": "array",
            "items": {"type": "number"}
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "items", "hero"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "items": {"type": "array", "items": {"type": "string"}},
                "hero": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["spirit", "health"],
                  "properties": {
                    "spirit": {"type": "integer"},
                    "health": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["max", "start"],
                      "properties": {
                        "max": {"type": "integer"},
                        "start": {"type": "integer"},
                        "initial": {"type": "integer"},
                        "after": {"type": "integer"}
                      }
                    }
                  }
                },
                "damage_popups": {"type": "array", "items": {"type": "integer"}}
              }
            }
          }
        }
      }
    }
  }
}
