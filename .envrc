export REPO_ROOT=$PWD
export VIRTUAL_ENV=$REPO_ROOT/.venv
export PYRIGHT=basedpyright

path_add PATH \
  $REPO_ROOT/bin \
  $VIRTUAL_ENV/bin \
;

# Last word: machine-local settings, gitignored and watched. Set DEADLOCK_HOME
# here when your Deadlock install isn't at the stock native-Linux Steam path
# (see deadlock.paths.DEFAULT_HOME).
dotenv_if_exists localhost.env
