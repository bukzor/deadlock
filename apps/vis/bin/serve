#!/bin/bash
# usage: [PORT=5173] [API_PORT=8788] apps/vis/bin/serve
# The live loop, in one command: Vite (hot module reload) on PORT is the URL to
# open, proxying /api to `vis-server serve --reload` on API_PORT, which restarts
# on a change to the server or deadlock sources. Ctrl-C stops both.
set -euo pipefail
shopt -s failglob
[[ -z "${DEBUG:-}" ]] || set -x

vis=$(dirname "$(dirname "$(readlink -f "$0")")")
client="$vis/client"
port="${PORT:-5173}"
api_port="${API_PORT:-8788}"

# Never take a port someone else holds (perhaps the user's own server).
for p in "$port" "$api_port"; do
  if timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$p" 2>/dev/null; then
    echo >&2 "vis: port $p is taken; set PORT / API_PORT to free ones"
    exit 1
  fi
done

# The server is its own uv project; a caller's activated venv is not its venv.
unset VIRTUAL_ENV

if [[ ! -d "$client/node_modules" || "$client/pnpm-lock.yaml" -nt "$client/node_modules" ]]; then
  pnpm --dir "$client" install --frozen-lockfile
  touch "$client/node_modules"
fi

# Each child is its own process group (set -m), so one kill takes its whole tree.
set -m
pids=()
stop() {
  trap - EXIT INT TERM
  for pid in "${pids[@]}"; do kill -- "-$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap stop EXIT
trap 'exit 130' INT TERM

uv run --project "$vis/server" vis-server serve --reload --port "$api_port" &
pids+=("$!")
(cd "$client" && VIS_API="http://127.0.0.1:$api_port" exec node_modules/.bin/vite --port "$port" --strictPort --clearScreen false) &
pids+=("$!")

# Vite prints its own "Local:" lines; the "open" line is the last word, after both children listen.
up() { timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null; }
until up "$port" && up "$api_port"; do
  for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null || wait "$pid" || exit 1; done
  sleep 0.3
done
echo >&2 "vis: open http://localhost:$port/  (API on :$api_port; Ctrl-C stops both)"
wait -n   # either child exiting ends the script
