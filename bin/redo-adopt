#!/usr/bin/env python3
"""redo-adopt: mark existing files as redo-generated targets.

redo deliberately refuses to overwrite a file it didn't generate — djb's rule,
so a `default.c.do` can't clobber a hand-written `hello.c`. But it decides
"didn't generate" from its own state database, which a fresh `git clone`
doesn't have. So a *committed* build output looks hand-written, and redo skips
it while exiting 0: the build silently keeps stale content.

Adopting a target says "this file is mine, rebuild it when its dependencies
change". That's the missing counterpart to redo's implicit disown; upstream has
no such command, so this reaches into redo's own state module (pinned version,
tiny surface — see docs/dev/environment.kb/toolchain.md).

An adopted target is marked "never built", so redo rebuilds it once and can
then verify it normally. Claiming it were up to date would be a lie: without
dependency records there is no basis for that claim, and redo would skip a
stale file forever.

Idempotent: a target redo already owns, unchanged since it built it, is left
alone rather than needlessly re-dirtied. A target that *has* changed is
reclaimed on the spot, without waiting for a build to notice the edit.

Usage: bin/redo-adopt [--if-exists] <path>...

  --if-exists  skip paths that don't exist, rather than failing (for callers
               adopting a fixed list that `redo clean` may have removed)
"""

import os
import shutil
import sys


def _redo_lib() -> str:
    """redo keeps its modules in a private lib dir beside its executables."""
    exe = shutil.which("redo")
    if not exe:
        sys.exit("redo-adopt: redo is not on PATH")
    return os.path.join(os.path.dirname(os.path.realpath(exe)), "..", "lib")


sys.path.insert(0, _redo_lib())

from redo import state  # noqa: E402  (import must follow the sys.path setup)


def adopt(paths: list[str], if_exists: bool = False) -> None:
    state.init([])
    for path in paths:
        if not os.path.exists(path):
            if if_exists:
                continue
            sys.exit(f"redo-adopt: no such file: {path}")
        f = state.File(name=os.path.abspath(path))
        if f.is_generated and not f.is_override and f.stamp == f.read_stamp():
            # already redo's and untouched since it built; re-adopting would
            # force a needless rebuild. Comparing stamps rather than trusting
            # is_override means an edited target is reclaimed immediately,
            # without waiting for a build to notice the edit first.
            continue
        # Match the on-disk stamp so redo doesn't read this as a target someone
        # edited behind its back (which would demote it to a static file), but
        # leave changed_runid unset: "mine, never built" is what makes it dirty.
        f.stamp = f.read_stamp()
        f.is_generated = True
        f.is_override = False
        f.changed_runid = None
        f.failed_runid = None
        f.save()
    state.commit()


def main(argv: list[str]) -> None:
    args = argv[1:]
    if_exists = "--if-exists" in args
    paths = [a for a in args if a != "--if-exists"]
    if not paths:
        sys.exit("usage: bin/redo-adopt [--if-exists] <path>...")
    adopt(paths, if_exists)


if __name__ == "__main__":
    main(sys.argv)
