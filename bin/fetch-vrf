#!/bin/bash
# Download, verify, and unpack the ValveResourceFormat / Source2Viewer-CLI
# release named in a release record (data/tools/vrf-release.json: version,
# sha256) into a destination directory.
#
# Unconditional and dependency-naive: it always fetches. Deciding *whether* a
# fetch is needed belongs to the build — the sibling
# data/tools/Source2Viewer-CLI.d.do calls this to populate its target.
#
# Usage: bin/fetch-vrf <release.json> <dest-dir>
set -euo pipefail
export DEBUG="${DEBUG:-0}"

onerror() {
  error="$?"
  echo >&2 "ERROR($error): fetch-vrf failed"
  exit "$error"
}
trap onerror ERR

release="${1:?usage: bin/fetch-vrf <release.json> <dest-dir>}"
dest="${2:?usage: bin/fetch-vrf <release.json> <dest-dir>}"
version=$(jq -er .version "$release")
sha256=$(jq -er .sha256 "$release")
url="https://github.com/ValveResourceFormat/ValveResourceFormat/releases/download/${version}/cli-linux-x64.zip"
zip="$dest/cli-linux-x64.zip"

if (( DEBUG > 0 )); then
  set -x
fi

mkdir -p "$dest"
wget -q -O "$zip" "$url"
sha256sum -c - <<<"$sha256  $zip"
unzip -q "$zip" -d "$dest"
rm "$zip"
chmod +x "$dest/Source2Viewer-CLI"

# smoke-test where the CLI can find its sibling .so libraries
"$dest/Source2Viewer-CLI" --version
